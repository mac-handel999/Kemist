{
  "name": "kemist",
  "version": "0.1.0",
  "description": "Kemist - verify Nigerian drugs against NAFDAC registration data and find nearby pharmacies, clinics and hospitals.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "sync:drugs": "node scripts/sync-drugs.js",
    "sync:file": "node scripts/sync-drugs.js --file",
    "sync:clinical": "node scripts/import-clinical.js",
    "prefill:facilities": "node scripts/prefill-facilities.js",
    "test": "node --test",
    "check:library": "node scripts/check-library.js",
    "import:serpapi": "node scripts/import-serpapi.js",
    "import:news": "node scripts/import-news.js",
    "import:alerts": "node scripts/import-alerts.js",
    "images:add": "node scripts/add-drug-image.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "@supabase/supabase-js": "^2.45.0"
  }
}
