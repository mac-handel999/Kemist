# --- Server ---
PORT=3000
# Set to 1 when deployed behind a proxy (Render, Railway, Vercel, Nginx) so rate limits see real client IPs
# TRUST_PROXY=1

# --- Supabase (leave blank to run in demo mode with sample data) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-side only. NEVER put this in frontend code or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- NAFDAC data import (Apify) ---
APIFY_TOKEN=
# Copy from the actor page on Apify, format: username~actor-name
APIFY_ACTOR_ID=
# JSON input for the actor. Check the actor's Input tab for the real field names. Start small:
APIFY_INPUT={"maxItems":100}

# --- Optional: openFDA (US drug labels). A free key raises the rate limit: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# --- Optional: SerpApi (Google Maps listings for the map). POC data source. https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# Free plan = 250 searches/month. The importer stops at this number (keeps a small buffer).
SERPAPI_MONTHLY_LIMIT=240
# SERPAPI_GL=ng

# --- Optional: several keys per provider. The next key is used automatically when one runs out. ---
# Only use keys you are entitled to (your own paid account, a teammate's account). Do not open extra free accounts to dodge limits.
# SERPAPI_API_KEYS=key1,key2
# APIFY_TOKENS=token1,token2
# GROQ_API_KEYS=key1,key2
# OPENFDA_API_KEYS=key1,key2

# --- AI assistant (Groq). Llama 3.3 70B was retired in Aug 2026; gpt-oss-120b is the default now. ---
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# --- Map tiles and place search (optional). With GEOAPIFY_API_KEY set and no MAP_TILE_URL, Geoapify tiles and search are used. ---
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# GEOAPIFY_API_KEY=
# NOMINATIM_EMAIL=you@example.com

# --- Geofencing (optional). Foreground-only pharmacy/hospital proximity alerts for Nigeria. ---
# GEOFENCE_ENTER_RADIUS=300
# GEOFENCE_EXIT_RADIUS=400
# GEOFENCE_COOLDOWN_MINUTES=30
# GEOFENCE_MIN_ACCURACY=150
# GEOFENCE_THROTTLE_MS=15000
