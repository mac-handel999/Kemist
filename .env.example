PORT=3000
# TRUST_PROXY=1

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: map tile provider. Defaults to OpenStreetMap.
# If GEOAPIFY_API_KEY is set the tile URL is composed server-side so the key never reaches the
# browser; otherwise MAP_TILE_URL/MAP_TILE_ATTRIBUTION take over.
# GEOAPIFY_API_KEY=
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors

#APIFY_TOKEN=
#APIFY_ACTOR_ID=
#APIFY_INPUT={"maxItems":100}